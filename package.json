{
  "name": "@simplecyon/pi-packages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cyon's package-only extensions and themes for Pi",
  "packageManager": "pnpm@11.9.0",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-theme"
  ],
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "pnpm -r --if-present run check && pnpm run test:integration",
    "test:integration": "node --test tests/*.test.mjs",
    "release:dry-run": "node scripts/release-dry-run.mjs"
  },
  "pi": {
    "extensions": [
      "./packages/pi-ask-user-question/src/index.ts",
      "./packages/pi-safe-operation/src/index.ts",
      "./packages/pi-context-artifacts/src/index.ts",
      "./packages/pi-context-engine/src/index.ts",
      "./packages/pi-token-roi/src/index.ts",
      "./packages/pi-minimal-tui/src/index.ts",
      "./packages/pi-memory/src/index.ts",
      "./packages/pi-context-compact/src/index.ts",
      "./packages/pi-context-inspector/index.ts",
      "./packages/pi-session-tasks/src/index.ts",
      "./packages/pi-skill-telemetry/src/index.ts"
    ],
    "skills": [
      "./packages/pi-memory/skills"
    ],
    "themes": [
      "./packages/pi-minimal-tui/themes"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
