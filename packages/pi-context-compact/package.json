{
  "name": "@cyon/pi-context-compact",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Standalone checkpoint and searchable cold-history compaction for Pi",
  "keywords": [
    "pi-package",
    "pi-extension",
    "context",
    "compaction"
  ],
  "license": "MIT",
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "typebox": "1.1.38"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.82.1 <0.83.0",
    "@earendil-works/pi-tui": ">=0.82.1 <0.83.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
